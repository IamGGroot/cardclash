# Copy this file to `.env` (or export these in your shell / hosting provider's
# dashboard) before running the server. Nothing here is a real secret — fill
# in your own values. The server runs fine with none of this set: online play
# works with zero configuration, and every payment endpoint just replies with
# a clear "not configured" error until you add Stripe keys.

# Port the HTTP+WebSocket server listens on. The static game client (served
# separately by dev-server.py on 8790) connects to this port.
PORT=8791

# Comma-separated list of origins allowed to open a WebSocket connection or
# call the REST endpoints. Set this to your real domain(s) in production —
# left as * during local development.
ALLOWED_ORIGINS=*

# Where the JSON account store is written. Fine as-is for local dev; point it
# somewhere persistent (a mounted volume) in production. This is a stand-in
# for a real database — see server/db.js for notes on swapping it out.
DB_FILE=./data/accounts.json

# ---- Stripe (payments) --------------------------------------------------
# Leave these unset to develop with payments disabled — /api/payments/*
# endpoints stay live but return 501 until a secret key is present.
#
# Secret key from the Stripe dashboard (Developers -> API keys). Use a
# sk_test_... key while developing.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (Developers -> Webhooks -> your
# endpoint -> Signing secret). Required to verify that webhook calls really
# came from Stripe before crediting anyone's account.
STRIPE_WEBHOOK_SECRET=

# Where Stripe should send the player back after checkout. Point these at
# the game client's URL once it's deployed somewhere real.
CHECKOUT_SUCCESS_URL=http://localhost:8790/?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:8790/?checkout=cancel

# Stripe Price IDs (price_...) for each real-money SKU defined in
# src/economy.js. Create matching Products/Prices in the Stripe dashboard
# and paste the IDs here — one env var per SKU id, prefixed STRIPE_PRICE_.
# See server/skus.js for the exact list of SKU ids that need one.
STRIPE_PRICE_gems_small=
STRIPE_PRICE_gems_medium=
STRIPE_PRICE_gems_large=
STRIPE_PRICE_coins_small=
STRIPE_PRICE_coins_medium=
STRIPE_PRICE_coins_large=
STRIPE_PRICE_dust_small=
STRIPE_PRICE_dust_medium=
STRIPE_PRICE_dust_large=
STRIPE_PRICE_welcome_offer=
